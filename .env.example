# Backend runtime (copy to .env locally; do not commit secrets)
PORT=8080
NODE_ENV=development
GOOGLE_CLOUD_PROJECT=resona-13
FIRESTORE_DATABASE_ID=default
FIREBASE_STORAGE_BUCKET=resona-13.firebasestorage.app
# Local ADC: run `gcloud auth application-default login` or set this to a
# credentials file stored outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
JWT_SECRET=replace-with-a-long-random-development-secret
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,capacitor://localhost,http://localhost

# Frontend build time. Set to the Cloud Run HTTPS URL in production builds.
VITE_API_URL=
